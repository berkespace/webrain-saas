generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MalKabulStatus {
  BEKLEMEDE
  NETLENDI
  IADE
}

model ambalajlar {
  id        String    @id
  ad        String
  tipi      String
  daraKg    Float     @db.Real
  aciklama  String?
  durum     String    @default("AKTIF")
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  mal_kabul_records mal_kabul_records[]
}

model faturalar {
  id            String    @id
  faturaNo      String    @unique
  tarih         DateTime? @default(now()) @db.Timestamp(6)
  toplamTutar   Float     @db.Real
  kdvOrani      Float?    @default(18.0) @db.Real
  kdvTutari     Float     @db.Real
  genelToplam   Float     @db.Real
  notlar        String?
  satinAlmaciId String
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  mal_kabul_records mal_kabul_records[]
  users             users               @relation(fields: [satinAlmaciId], references: [id])
}

model cari_hesaplar {
  id                String    @id
  saticiTipi        String // KOMISYONCU, MUSTAHSIL, OZEL_FIRMA, URETICI
  saticiId          String // Komisyoncu, Müstahsil, Özel Firma veya Üretici ID'si
  saticiAdi         String // Satıcı adı (display için)
  alisTarihi        DateTime  @db.Timestamp(6)
  fisNo             String
  malKabulRecordId  String    @unique // Mal kabul kaydına referans
  toplamAlisMiktari Float     @db.Real // Net KG veya Net Adet
  birimFiyat        Float     @db.Real
  kdvHaricTutar     Float     @db.Real // KDV ve vergi hariç tutar
  herseyDahilTutar  Float     @db.Real // KDV ve vergi dahil tutar
  cariBakiyesi      Float     @db.Real // Cari bakiyesi
  createdAt         DateTime? @default(now()) @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  malKabulRecord mal_kabul_records @relation(fields: [malKabulRecordId], references: [id])
}

model komisyoncular {
  id             String    @id
  createdAt      DateTime? @default(now()) @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @db.Timestamp(6)
  dukkanAdi      String
  durum          String    @default("AKTIF")
  komisyonNo     String    @unique
  komisyonKodu   String    @unique
  sehir          String
  vkn            String?
  yetkiliAdi     String?
  yetkiliTelefon String?

  // Relations
  mal_kabul_records mal_kabul_records[]
  ureticiler        ureticiler[]
}

model mal_kabul_records {
  id           String         @id
  tarih        DateTime?      @default(now()) @db.Timestamp(6)
  miktar       Float          @db.Real
  birimFiyat   Float?         @db.Real
  toplamFiyat  Float?         @db.Real
  status       MalKabulStatus @default(BEKLEMEDE)
  notlar       String?
  malKabulcuId String
  komisyoncuId String?
  ureticiId    String?
  urunId       String
  faturaId     String?
  createdAt    DateTime?      @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?      @default(now()) @db.Timestamp(6)
  fisNo        String         @unique
  mustahsilId  String?
  ozelFirmaId  String?
  saticiTipi   String         @default("OZEL_FIRMA")
  ambalajId    String?
  paletSayisi  Int?           @default(0)
  kasaSayisi   Int?           @default(0)
  adetSayisi   Int?           @default(0) // ADET birimi için adet sayısı
  brutKg       Float?         @default(0) @db.Real
  daraKg       Float?         @default(0) @db.Real
  girisKg      Float?         @default(0) @db.Real
  cikmaKg      Float?         @default(0) @db.Real // Ana çıkma miktarı
  fireKg       Float?         @default(0) @db.Real // Ekstradan kesilen fire miktarı
  cikmaFireKg  Float?         @default(0) @db.Real // Eski alan (geriye uyumluluk için)
  netKg        Float?         @default(0) @db.Real
  netAdet      Int?           @default(0) // ADET birimi için net adet (girisAdet - cikmaAdet - fireAdet)

  // Fiyat ve evrak bilgileri
  kdvHaricTutar        Float?    @default(0) @db.Real // KDV ve vergi hariç tutar
  kdvOrani             Float?    @default(0) @db.Real
  belediyeRusumOrani   Float?    @default(0) @db.Real
  kdvHesapla           Boolean   @default(false)
  belediyeRusumHesapla Boolean   @default(false)
  evraklar             String[]  @default([]) // Yüklenen evrak dosya yolları
  fiyatGirildi         Boolean   @default(false)
  fiyatGirenKullanici  String?
  fiyatGirilmeTarihi   DateTime? @db.Timestamp(6)

  // Manuel fatura bilgileri
  faturaYontemi    String?   @default("EVRAK") // "EVRAK" veya "MANUEL"
  faturaSeriNo     String? // Manuel fatura seri numarası
  faturaTarihi     DateTime? @db.Timestamp(6) // Manuel fatura tarihi
  faturaAciklamasi String? // Manuel fatura açıklaması

  // Onay sistemi
  onayDurumu         String?   @default("BEKLEMEDE") // "BEKLEMEDE", "ONAYLANDI", "REDDEDILDI"
  onaylayanKullanici String? // Onaylayan muhasebeci kullanıcı ID'si
  onayTarihi         DateTime? @db.Timestamp(6) // Onay tarihi
  redDetayi          String? // Red nedeni

  // Relations
  users         users          @relation(fields: [malKabulcuId], references: [id])
  komisyoncular komisyoncular? @relation(fields: [komisyoncuId], references: [id])
  ureticiler    ureticiler?    @relation(fields: [ureticiId], references: [id])
  urunler       urunler        @relation(fields: [urunId], references: [id])
  faturalar     faturalar?     @relation(fields: [faturaId], references: [id])
  mustahsil     mustahsil?     @relation(fields: [mustahsilId], references: [id])
  ozel_firmalar ozel_firmalar? @relation(fields: [ozelFirmaId], references: [id])
  ambalajlar    ambalajlar?    @relation(fields: [ambalajId], references: [id])
  cari_hesaplar cari_hesaplar?
}

model mustahsil {
  id          String    @id
  ad          String
  soyad       String
  dogumTarihi DateTime  @db.Timestamp(6)
  tcKimlikNo  String    @unique
  mustahsilNo String    @unique
  iletisim    String?
  bankaAdi    String?
  ibanAdresi  String?
  adres       String?
  cinsiyet    String
  durum       String    @default("AKTIF")
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  mal_kabul_records mal_kabul_records[]
}

model ozel_firmalar {
  id             String    @id
  firmaAdi       String
  firmaNo        String    @unique
  vkn            String?
  vergiDairesi   String?
  yetkiliAdi     String?
  yetkiliTelefon String?
  sehir          String
  adres          String?
  durum          String    @default("AKTIF")
  createdAt      DateTime? @default(now()) @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  mal_kabul_records mal_kabul_records[]
}

model ureticiler {
  id           String    @id
  ad           String
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)
  cinsiyet     String
  dogumTarihi  DateTime? @db.Timestamp(6)
  iletisim     String?
  komisyoncuId String?
  sehir        String
  soyad        String
  tcNo         String?
  durum        String    @default("AKTIF")

  // Relations
  mal_kabul_records mal_kabul_records[]
  komisyoncular     komisyoncular?      @relation(fields: [komisyoncuId], references: [id])
}

model urunler {
  id        String    @id
  ad        String
  stokKodu  String    @unique
  kategori  String?
  birim     String
  durum     String    @default("AKTIF")
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  mal_kabul_records mal_kabul_records[]
}

model users {
  id           String    @id
  firstName    String
  lastName     String
  email        String    @unique
  password     String
  role         String    @default("MAL_KABULCU")
  // Admin tarafından tanımlanan iletişim bilgileri
  contactEmail String?
  phone        String?
  gender       String?
  birthDate    DateTime? @db.Timestamp(6)

  // Oturum bilgileri
  lastLoginAt  DateTime? @db.Timestamp(6)
  lastLogoutAt DateTime? @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  mal_kabul_records  mal_kabul_records[]
  faturalar          faturalar[]
  notifications      notifications[]
  push_subscriptions push_subscriptions[]
  activityLogs       user_activity_logs[]
}

model user_activity_logs {
  id        String   @id @default(cuid())
  userId    String
  action    String // LOGIN, LOGOUT, CREATE_RECORD, UPDATE_RECORD, APPROVE_INVOICE, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  user users @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("user_activity_logs")
}

model malKabulRecords {
  id         String    @id
  fisNo      String
  tarih      DateTime  @db.Timestamp(6)
  saticiTipi String
  saticiId   String
  urunId     String
  ureticiId  String
  ambalajId  String
  brutKg     Float     @db.Real
  daraKg     Float     @db.Real
  girisKg    Float     @db.Real
  cikmaKg    Float     @default(0) @db.Real
  fireKg     Float     @default(0) @db.Real
  netKg      Float     @default(0) @db.Real
  urunDurumu String    @default("BEKLEMEDE")
  userId     String
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)
}

enum AmbalajTipi {
  PALET
  PLASTIK_KASA
  KARTON_KASA
}

enum Gender {
  ERKEK
  KADIN
}

enum ProductStatus {
  FATURA_BEKLIYOR
  FATURALANDI
  NETLENDI
  TAMAMLANDI
  IPTAL
}

enum SaticiTipi {
  OZEL_FIRMA
  MUSTAHSIL
  KOMISYONCU
}

enum Status {
  AKTIF
  PASIF
}

enum UserRole {
  ADMIN
  MAL_KABULCU
  MUHASEBE
  SATIN_ALMACI
}

model notifications {
  id           String   @id @default(cuid())
  userId       String // Alıcı kullanıcı
  title        String // Bildirim başlığı
  message      String // Bildirim içeriği
  type         String // 'INFO', 'WARNING', 'SUCCESS', 'ERROR', 'WORKFLOW'
  category     String // 'MAL_KABUL', 'SATIN_ALMA', 'MUHASEBE', 'SYSTEM'
  priority     String   @default("NORMAL") // 'LOW', 'NORMAL', 'HIGH', 'URGENT'
  isRead       Boolean  @default(false)
  isEmailSent  Boolean  @default(false)
  isPushSent   Boolean  @default(false)
  isSMSSent    Boolean  @default(false)
  relatedId    String? // İlgili kayıt ID'si (mal_kabul_record id vs.)
  relatedModel String? // İlgili model adı
  actionUrl    String? // Tıklandığında gidilecek URL
  metadata     Json? // Ek veriler
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // İlişkiler
  user users @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model push_subscriptions {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dhKey String
  authKey   String
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  user users @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}
