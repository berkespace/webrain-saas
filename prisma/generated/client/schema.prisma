generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ambalajlar {
  id                String              @id
  ad                String
  tipi              AmbalajTipi
  daraKg            Float
  aciklama          String?
  durum             Status              @default(AKTIF)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  mal_kabul_records mal_kabul_records[]
}

model faturalar {
  id                String              @id
  faturaNo          String              @unique
  tarih             DateTime            @default(now())
  toplamTutar       Float
  kdvOrani          Float               @default(18.0)
  kdvTutari         Float
  genelToplam       Float
  notlar            String?
  satinAlmaciId     String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  users             users               @relation(fields: [satinAlmaciId], references: [id])
  mal_kabul_records mal_kabul_records[]
}

model komisyoncular {
  id                String              @id
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  dukkanAdi         String
  durum             Status              @default(AKTIF)
  komisyonNo        String              @unique
  sehir             String
  vkn               String?
  yetkiliAdi        String?
  yetkiliTelefon    String?
  komisyonKodu      String              @unique
  mal_kabul_records mal_kabul_records[]
  ureticiler        ureticiler[]
}

model mal_kabul_records {
  id            String         @id
  tarih         DateTime       @default(now())
  miktar        Float
  birimFiyat    Float?
  toplamFiyat   Float?
  status        ProductStatus  @default(FATURA_BEKLIYOR)
  notlar        String?
  malKabulcuId  String
  komisyoncuId  String?
  ureticiId     String?
  urunId        String
  faturaId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  fisNo         String         @unique
  mustahsilId   String?
  ozelFirmaId   String?
  saticiTipi    SaticiTipi     @default(OZEL_FIRMA)
  ambalajId     String?
  paletSayisi   Int            @default(0)
  kasaSayisi    Int            @default(0)
  brutKg        Float          @default(0)
  daraKg        Float          @default(0)
  girisKg       Float          @default(0)
  cikmaFireKg   Float          @default(0)
  netKg         Float          @default(0)
  ambalajlar    ambalajlar?    @relation(fields: [ambalajId], references: [id])
  faturalar     faturalar?     @relation(fields: [faturaId], references: [id])
  komisyoncular komisyoncular? @relation(fields: [komisyoncuId], references: [id])
  users         users          @relation(fields: [malKabulcuId], references: [id])
  mustahsil     mustahsil?     @relation(fields: [mustahsilId], references: [id])
  ozel_firmalar ozel_firmalar? @relation(fields: [ozelFirmaId], references: [id])
  ureticiler    ureticiler?    @relation(fields: [ureticiId], references: [id])
  urunler       urunler        @relation(fields: [urunId], references: [id])
}

model mustahsil {
  id                String              @id
  ad                String
  soyad             String
  dogumTarihi       DateTime
  tcKimlikNo        String              @unique
  ibanAdresi        String?
  adres             String?
  cinsiyet          Gender
  durum             Status              @default(AKTIF)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  mustahsilNo       String              @unique
  iletisim          String?
  bankaAdi          String?
  mal_kabul_records mal_kabul_records[]
}

model ozel_firmalar {
  id                String              @id
  firmaAdi          String
  vkn               String?
  yetkiliAdi        String?
  yetkiliTelefon    String?
  sehir             String
  adres             String?
  durum             Status              @default(AKTIF)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  firmaNo           String              @unique
  vergiDairesi      String?
  mal_kabul_records mal_kabul_records[]
}

model ureticiler {
  id                String              @id
  ad                String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  cinsiyet          Gender
  dogumTarihi       DateTime?
  durum             Status              @default(AKTIF)
  iletisim          String?
  komisyoncuId      String?
  sehir             String
  soyad             String
  tcNo              String?
  mal_kabul_records mal_kabul_records[]
  komisyoncular     komisyoncular?      @relation(fields: [komisyoncuId], references: [id])
}

model urunler {
  id                String              @id
  ad                String
  kategori          String?
  birim             String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  durum             Status              @default(AKTIF)
  stokKodu          String              @unique
  mal_kabul_records mal_kabul_records[]
}

model users {
  id                String              @id
  firstName         String
  lastName          String
  email             String              @unique
  password          String
  role              UserRole            @default(MAL_KABULCU)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  faturalar         faturalar[]
  mal_kabul_records mal_kabul_records[]
}

enum AmbalajTipi {
  PALET
  PLASTIK_KASA
  KARTON_KASA
}

enum Gender {
  ERKEK
  KADIN
}

enum ProductStatus {
  FATURA_BEKLIYOR
  FATURALANDI
  NETLENDI
  TAMAMLANDI
  IPTAL
}

enum SaticiTipi {
  OZEL_FIRMA
  MUSTAHSIL
  KOMISYONCU
}

enum Status {
  AKTIF
  PASIF
}

enum UserRole {
  ADMIN
  MAL_KABULCU
  MUHASEBE
  SATIN_ALMACI
}
